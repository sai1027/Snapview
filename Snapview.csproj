<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Snapview</AssemblyName>
    <Version>0.2.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>Assets\Snapview.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-x64" Version="14.16.0" />
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <Content Include="tessdata\eng.traineddata" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="licenses\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="docs\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="LICENSE;README.md;THIRD-PARTY-NOTICES.md;AGENTS.md" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\Snapview-mark.png;Assets\Snapview.ico" />
    <Compile Remove="tests\**" />
  </ItemGroup>
</Project>
