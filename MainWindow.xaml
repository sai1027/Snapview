<Window x:Class="Snapview.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Snapview" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" Title="Snapview" Icon="Assets/Snapview.ico" Width="1160" Height="790" MinWidth="850" MinHeight="590" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" WindowStyle="None" ResizeMode="CanResize" AllowDrop="True" Drop="WindowDrop" DragOver="WindowDragOver" PreviewKeyDown="WindowKeyDown" PreviewMouseDown="WindowMouseDown" Deactivated="WindowDeactivated" Closing="WindowClosing">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="44" CornerRadius="8" GlassFrameThickness="0" ResizeBorderThickness="6"/></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
        <Grid Margin="8,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel x:Name="TitleSection" Orientation="Horizontal" VerticalAlignment="Center" SizeChanged="HeaderSizeChanged">
            <Image Source="Assets/Snapview-mark.png" Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Grid x:Name="TitleArea" MaxWidth="220" Margin="0,0,4,0">
              <Button x:Name="CopyPathButton" Click="TitleClick" PreviewMouseLeftButtonDown="TitleMouseDown" Height="30" Padding="4,3" HorizontalContentAlignment="Left" IsEnabled="False" ToolTip="Copy image path" AutomationProperties.Name="Image filename: click to copy path, double-click to rename" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBlock x:Name="TitleLabel" Text="Snapview" FontSize="12" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </Button>
              <DockPanel x:Name="RenameHost" Visibility="Collapsed" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBlock x:Name="RenameExtension" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="4,0" MaxWidth="58" TextTrimming="CharacterEllipsis"/>
                <TextBox x:Name="RenameInput" MinWidth="70" Height="28" Padding="4,2" VerticalContentAlignment="Center" LostKeyboardFocus="RenameLostFocus" AutomationProperties.Name="Image file name" ToolTip="Enter or click outside to rename · Esc to cancel · Ctrl+Z to undo typing"/>
              </DockPanel>
            </Grid>
            <Button Click="OpenClick" Style="{StaticResource ToolbarButton}" ToolTip="Open image · Ctrl+O" AutomationProperties.Name="Open image" shell:WindowChrome.IsHitTestVisibleInChrome="True"><local:UiIcon Kind="Open"/></Button>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="UndoButton" Click="UndoClick" Style="{StaticResource ToolbarButton}" IsEnabled="False" ToolTip="Undo · Ctrl+Z" AutomationProperties.Name="Undo"><local:UiIcon Kind="Undo"/></Button>
            <Button x:Name="RedoButton" Click="RedoClick" Style="{StaticResource ToolbarButton}" IsEnabled="False" ToolTip="Redo · Ctrl+Y / Ctrl+Shift+Z" AutomationProperties.Name="Redo"><local:UiIcon Kind="Redo"/></Button>
            <Button x:Name="InfoButton" Click="InfoClick" Style="{StaticResource ToolbarButton}" IsEnabled="False" ToolTip="Image information · Ctrl+I" AutomationProperties.Name="Image information"><local:UiIcon Kind="Info"/></Button>
            <Button x:Name="DeleteImageButton" Click="DeleteImageClick" Style="{StaticResource ToolbarButton}" IsEnabled="False" ToolTip="Delete image from disk · Delete when no object is selected" AutomationProperties.Name="Delete image from disk"><local:UiIcon Kind="Delete"/></Button>
            <Button x:Name="SaveButton" Content="Save copy" Click="SaveCopyClick" Style="{StaticResource ToolbarButton}" Width="68" FontSize="11" BorderBrush="{DynamicResource Divider}" BorderThickness="1" IsEnabled="False" Margin="3,0" ToolTip="Save copy or convert · Ctrl+Shift+S"/>
            <Button Click="MoreClick" Style="{StaticResource ToolbarButton}" ToolTip="More options" AutomationProperties.Name="More options"><local:UiIcon Kind="More"/></Button>
            <Border Width="1" Height="17" Background="{DynamicResource Divider}" Margin="4,0"/>
            <Button Click="MinimizeClick" Style="{StaticResource CaptionButton}" ToolTip="Minimize" AutomationProperties.Name="Minimize"><local:UiIcon Kind="Minimize" Width="12" Height="12"/></Button>
            <Button x:Name="MaximizeButton" Click="MaximizeClick" Style="{StaticResource CaptionButton}" ToolTip="Maximize" AutomationProperties.Name="Maximize"><local:UiIcon x:Name="MaximizeIcon" Kind="Maximize" Width="12" Height="12"/></Button>
            <Button Click="CloseClick" Style="{StaticResource CaptionButton}" ToolTip="Close" AutomationProperties.Name="Close"><local:UiIcon Kind="Close" Width="13" Height="13"/></Button>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border x:Name="CanvasArea" Background="{DynamicResource Canvas}" ClipToBounds="True">
          <Grid>
            <ScrollViewer x:Name="Viewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="30" SizeChanged="ViewerSizeChanged" PreviewMouseWheel="ViewerMouseWheel" ScrollChanged="ViewerScrolled">
              <Grid x:Name="ImageHost" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White">
                <Grid.LayoutTransform><ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/></Grid.LayoutTransform>
                <Image x:Name="Photo" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                <local:AnnotationEditor x:Name="Annotations" ClipToBounds="True"/>
                <Canvas x:Name="Overlay" Visibility="Collapsed" Background="Transparent" ClipToBounds="True" MouseLeftButtonDown="CanvasDown" MouseMove="CanvasMove" MouseLeftButtonUp="CanvasUp" LostMouseCapture="CanvasLostCapture"/>
              </Grid>
            </ScrollViewer>
            <StackPanel x:Name="Welcome" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-12,0,0">
              <Image Source="Assets/Snapview-mark.png" Width="46" Height="46" HorizontalAlignment="Center" Margin="0,0,0,24"/>
              <TextBlock Text="A little more picture.&#x0a;A little less everything else." TextAlignment="Center" FontSize="27" FontWeight="SemiBold" LineHeight="36"/>
              <TextBlock Text="Open an image. Make it yours. Carry on." Foreground="{DynamicResource Muted}" FontSize="13" HorizontalAlignment="Center" Margin="0,14,0,24"/>
              <Button Content="Open an image" Style="{StaticResource Primary}" HorizontalAlignment="Center" Click="OpenClick"/>
              <TextBlock Text="or drop it here  ·  Ctrl + O" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" FontSize="12" Margin="0,14,0,0"/>
            </StackPanel>
            <Border x:Name="ToastBox" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20,20,20,18" Background="{DynamicResource ToastSurface}" CornerRadius="7" Padding="14,9" Visibility="Collapsed" IsHitTestVisible="False"><TextBlock x:Name="ToastText" Foreground="{DynamicResource ToastInk}" TextWrapping="Wrap" MaxWidth="620" FontSize="12"/></Border>
          </Grid>
        </Border>
        <Border Grid.Column="1" x:Name="InfoPanel" Width="290" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}" BorderThickness="1,0,0,0" Visibility="Collapsed">
          <DockPanel Margin="20,18,16,16">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,18"><TextBlock Text="Image details" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><Button HorizontalAlignment="Right" Click="InfoClick" Style="{StaticResource ToolbarButton}" ToolTip="Close details" AutomationProperties.Name="Close details"><local:UiIcon Kind="Close"/></Button></Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="InfoContents"/></ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
      <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
        <Grid Margin="12,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="FileStatus" Text="Just you and your images" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
          <StackPanel x:Name="ZoomTools" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="False">
            <Button Click="ZoomOutClick" Style="{StaticResource FooterButton}" ToolTip="Zoom out · −" AutomationProperties.Name="Zoom out"><local:UiIcon Kind="Minus" Width="12" Height="12"/></Button>
            <Button x:Name="ZoomLabel" Click="ActualClick" Content="100%" Style="{StaticResource FooterButton}" Width="54" FontSize="11" ToolTip="Actual size · Ctrl+1"/>
            <Button Click="ZoomInClick" Style="{StaticResource FooterButton}" ToolTip="Zoom in · +" AutomationProperties.Name="Zoom in"><local:UiIcon Kind="Plus" Width="12" Height="12"/></Button>
            <Border Width="1" Height="12" Background="{DynamicResource Divider}" Margin="8,0"/>
            <Button Content="Fit" Click="FitClick" Style="{StaticResource FooterButton}" Width="32" FontSize="11" ToolTip="Fit to window · Ctrl+0"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock x:Name="PositionLabel" Text="LOCAL. SIMPLE. YOURS." Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="8,0"/>
            <Button x:Name="PrevButton" Click="PrevClick" Style="{StaticResource FooterButton}" Visibility="Collapsed" ToolTip="Previous image · ←" AutomationProperties.Name="Previous image"><local:UiIcon Kind="Previous" Width="12" Height="12"/></Button>
            <Button x:Name="NextButton" Click="NextClick" Style="{StaticResource FooterButton}" Visibility="Collapsed" ToolTip="Next image · →" AutomationProperties.Name="Next image"><local:UiIcon Kind="Next" Width="12" Height="12"/></Button>
          </StackPanel>
        </Grid>
      </Border>
      <!-- A null-background canvas lets all unused space pass pointer input to the image. -->
      <Canvas x:Name="ToolLayer" Grid.RowSpan="2" Panel.ZIndex="10" ClipToBounds="True">
        <Border x:Name="ToolPalette" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="6" Padding="3" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <StackPanel Orientation="Horizontal">
            <Thumb x:Name="ToolbarGrip" Width="20" Height="26" Cursor="SizeAll" Focusable="True" Foreground="{DynamicResource Muted}" ToolTip="Drag toolbar · double-click or Home to dock · arrow keys to move" AutomationProperties.Name="Move toolbar" AutomationProperties.HelpText="Drag to move toolbar and options; double-click or Home to return to the header.">
              <Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="GripSurface" Background="Transparent" CornerRadius="4"><local:UiIcon Kind="Grip" Width="12" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="GripSurface" Property="Background" Value="{DynamicResource Hover}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="GripSurface" Property="Background" Value="{DynamicResource Selected}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template>
            </Thumb>
            <Border Width="1" Height="16" Background="{DynamicResource Divider}" Margin="3,0" VerticalAlignment="Center"/>
            <StackPanel x:Name="EditTools" Orientation="Horizontal" IsEnabled="False">
              <Button x:Name="CropToolButton" Click="CropClick" Style="{StaticResource ToolbarButton}" ToolTip="Crop · C" AutomationProperties.Name="Crop"><local:UiIcon Kind="Crop"/></Button>
              <Button Click="ResizeClick" Style="{StaticResource ToolbarButton}" ToolTip="Resize" AutomationProperties.Name="Resize"><local:UiIcon Kind="Resize"/></Button>
              <Button Click="RotateClick" Style="{StaticResource ToolbarButton}" ToolTip="Rotate clockwise · R" AutomationProperties.Name="Rotate clockwise"><local:UiIcon Kind="Rotate"/></Button>
              <Button x:Name="MarkupButton" Click="MarkupClick" Style="{StaticResource ToolbarButton}" ToolTip="Markup · M" AutomationProperties.Name="Markup"><local:UiIcon Kind="Pen"/></Button>
              <Button x:Name="AddTextButton" Click="TextClick" Style="{StaticResource ToolbarButton}" ToolTip="Add text to image · T" AutomationProperties.Name="Add text to image"><local:UiIcon Kind="Text"/></Button>
              <Button x:Name="OcrButton" Click="OcrClick" Style="{StaticResource ToolbarButton}" ToolTip="Extract text from image · Ctrl+Shift+C" AutomationProperties.Name="Extract text from image"><local:UiIcon Kind="Ocr"/></Button>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border x:Name="MarkupBar" Visibility="Collapsed" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="6" Padding="5" ToolTip="{Binding Text, ElementName=AnnotationHint}" AutomationProperties.HelpText="{Binding Text, ElementName=AnnotationHint}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <StackPanel Orientation="Horizontal">
            <WrapPanel x:Name="DrawingTools" Orientation="Horizontal" VerticalAlignment="Center">
              <StackPanel x:Name="ShapeTools" Orientation="Horizontal">
                <Button Tag="Select" Click="ToolClick" Style="{StaticResource ToolbarButton}" ToolTip="Select and move objects · V" AutomationProperties.Name="Select objects"><local:UiIcon Kind="Select"/></Button>
                <Button Tag="Pen" Click="ToolClick" Style="{StaticResource ToolbarButton}" ToolTip="Freehand pen" AutomationProperties.Name="Pen"><local:UiIcon Kind="Pen"/></Button>
                <Button Tag="Rectangle" Click="ToolClick" Style="{StaticResource ToolbarButton}" ToolTip="Rectangle" AutomationProperties.Name="Rectangle"><local:UiIcon Kind="Rectangle"/></Button>
                <Button Tag="Ellipse" Click="ToolClick" Style="{StaticResource ToolbarButton}" ToolTip="Ellipse" AutomationProperties.Name="Ellipse"><local:UiIcon Kind="Ellipse"/></Button>
                <Button Tag="Arrow" Click="ToolClick" Style="{StaticResource ToolbarButton}" ToolTip="Arrow" AutomationProperties.Name="Arrow"><local:UiIcon Kind="Arrow"/></Button>
                <Border Width="1" Height="16" Background="{DynamicResource Divider}" Margin="6,0" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel x:Name="InkSwatches" Orientation="Horizontal">
                <RadioButton Tag="#FFFFFF" Background="White" Style="{StaticResource InkSwatch}" GroupName="Ink" IsChecked="True" Click="ColorClick" ToolTip="White" AutomationProperties.Name="White ink"/>
                <RadioButton Tag="#27362C" Background="#27362C" Style="{StaticResource InkSwatch}" GroupName="Ink" Click="ColorClick" ToolTip="Charcoal" AutomationProperties.Name="Charcoal ink"/>
                <RadioButton Tag="#F5CE64" Background="#F5CE64" Style="{StaticResource InkSwatch}" GroupName="Ink" Click="ColorClick" ToolTip="Yellow" AutomationProperties.Name="Yellow ink"/>
                <RadioButton Tag="#EF7869" Background="#EF7869" Style="{StaticResource InkSwatch}" GroupName="Ink" Click="ColorClick" ToolTip="Coral" AutomationProperties.Name="Coral ink"/>
                <RadioButton Tag="#79A9DB" Background="#79A9DB" Style="{StaticResource InkSwatch}" GroupName="Ink" Click="ColorClick" ToolTip="Blue" AutomationProperties.Name="Blue ink"/>
              </StackPanel>
              <Border Width="1" Height="16" Background="{DynamicResource Divider}" Margin="6,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="StrokeLabel" Visibility="Collapsed"/>
              <ComboBox x:Name="StrokeSize" Width="58" Height="26" MinHeight="26" SelectedIndex="1" SelectionChanged="StrokeChanged" ToolTip="Stroke width in image pixels" AutomationProperties.Name="Stroke width"><ComboBoxItem Content="2"/><ComboBoxItem Content="5"/><ComboBoxItem Content="10"/><ComboBoxItem Content="20"/></ComboBox>
              <TextBlock x:Name="FontLabel" Text="Size" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="2,0,6,0" Visibility="Collapsed"/>
              <TextBox x:Name="FontSizeInput" Text="48" Width="44" Height="26" Padding="4,2" FontSize="12" Visibility="Collapsed" LostKeyboardFocus="FontSizeChanged" KeyDown="FontSizeKeyDown" ToolTip="Text size in image pixels · Enter to apply" AutomationProperties.Name="Text font size"/>
              <ToggleButton x:Name="BoldButton" Content="B" FontWeight="Bold" Style="{StaticResource TextEmphasis}" Visibility="Collapsed" Click="BoldClick" ToolTip="Bold selected text · Ctrl+B" AutomationProperties.Name="Bold text"/>
              <ToggleButton x:Name="ItalicButton" Style="{StaticResource TextEmphasis}" Visibility="Collapsed" Click="ItalicClick" ToolTip="Italic selected text · Ctrl+I while typing" AutomationProperties.Name="Italic text"><local:UiIcon Kind="Italic" Width="11" Height="11"/></ToggleButton>
              <Button x:Name="DeleteAnnotationButton" Click="DeleteAnnotationClick" Style="{StaticResource ToolbarButton}" ToolTip="Delete selected object · Delete" AutomationProperties.Name="Delete selected object" Margin="4,0,0,0" IsEnabled="False"><local:UiIcon Kind="Delete"/></Button>
            </WrapPanel>
            <TextBlock x:Name="CropHint" Text="Drag to select · Enter to apply · Esc to cancel" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="12" Margin="6,0,10,0" Visibility="Collapsed"/>
            <Button x:Name="ApplyCropButton" Click="ApplyCropClick" Style="{StaticResource ToolbarButton}" Width="Auto" Padding="8,3" Visibility="Collapsed" ToolTip="Apply crop · Enter"><TextBlock Text="Apply crop" FontSize="12"/></Button>
            <Button x:Name="DoneButton" Click="DoneClick" Style="{StaticResource ToolbarButton}" Margin="5,0,0,0" ToolTip="Finish editing · Esc" AutomationProperties.Name="Finish editing"><local:UiIcon x:Name="DoneIcon" Kind="Check"/></Button>
            <TextBlock x:Name="AnnotationHint" Visibility="Collapsed"/>
          </StackPanel>
        </Border>
      </Canvas>
    </Grid>
  </Border>
</Window>
