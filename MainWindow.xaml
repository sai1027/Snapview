<Window x:Class="Snapview.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Snapview"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Snapview" Icon="Assets/Snapview.ico" Width="1160" Height="790" MinWidth="850" MinHeight="590" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" AllowDrop="True" Drop="WindowDrop" DragOver="WindowDragOver" PreviewKeyDown="WindowKeyDown" Closing="WindowClosing">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="50" CornerRadius="10" GlassFrameThickness="0" ResizeBorderThickness="6"/></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="#DCE0DA" BorderThickness="1">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="51"/><RowDefinition Height="62"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="43"/></Grid.RowDefinitions>
    <Border BorderBrush="#E6E9E3" BorderThickness="0,0,0,1" Background="#FAFBF9">
      <Grid Margin="19,0,8,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="Assets/Snapview-mark.png" Width="30" Height="30" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="snapview" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
          <TextBlock Text=" / " Foreground="#CBD0C8" Margin="16,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="TitleLabel" Text="A clearer view" Foreground="{StaticResource Muted}" VerticalAlignment="Center" MaxWidth="420" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Content="&#xE921;" FontFamily="Segoe Fluent Icons" Width="43" Click="MinimizeClick" ToolTip="Minimize" AutomationProperties.Name="Minimize"/>
          <Button Content="&#xE922;" FontFamily="Segoe Fluent Icons" Width="43" Click="MaximizeClick" ToolTip="Maximize" AutomationProperties.Name="Maximize"/>
          <Button Content="&#xE8BB;" FontFamily="Segoe Fluent Icons" Width="43" Click="CloseClick" ToolTip="Close" AutomationProperties.Name="Close"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="18,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Click="OpenClick" ToolTip="Open image · Ctrl+O"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" Style="{StaticResource Glyph}" Margin="0,0,8,0"/><TextBlock Text="Open"/></StackPanel></Button>
        <Border Width="1" Height="22" Background="#DEE3DA" Margin="13,0"/>
        <StackPanel x:Name="EditTools" Orientation="Horizontal" IsEnabled="False">
          <Button Click="CropClick" ToolTip="Crop · C" AutomationProperties.Name="Crop"><TextBlock Text="&#xE7A8;" Style="{StaticResource Glyph}"/></Button>
          <Button Click="ResizeClick" ToolTip="Resize" AutomationProperties.Name="Resize"><TextBlock Text="&#xE740;" Style="{StaticResource Glyph}"/></Button>
          <Button Click="RotateClick" ToolTip="Rotate clockwise · R" AutomationProperties.Name="Rotate clockwise"><TextBlock Text="&#xE7AD;" Style="{StaticResource Glyph}"/></Button>
          <Border Width="1" Height="22" Background="#DEE3DA" Margin="13,0"/>
          <Button x:Name="MarkupButton" Click="MarkupClick" ToolTip="Markup · M"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" Style="{StaticResource Glyph}" Margin="0,0,8,0"/><TextBlock Text="Markup"/></StackPanel></Button>
          <Button x:Name="AddTextButton" Click="TextClick" ToolTip="Add text to image · T" AutomationProperties.Name="Add text to image"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E9;" Style="{StaticResource Glyph}" Margin="0,0,8,0"/><TextBlock Text="Add text"/></StackPanel></Button>
          <Button x:Name="OcrButton" Click="OcrClick" ToolTip="Extract text from image · Ctrl+Shift+C" AutomationProperties.Name="Extract text from image">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="18" Height="18" Margin="0,0,8,0"><Path Data="M1,6 V1 H6 M12,1 H17 V6 M17,12 V17 H12 M6,17 H1 V12 M5,6 H13 M5,9 H13 M5,12 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox>
              <TextBlock Text="Extract text"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="UndoButton" Click="UndoClick" IsEnabled="False" ToolTip="Undo · Ctrl+Z" AutomationProperties.Name="Undo"><TextBlock Text="&#xE7A7;" Style="{StaticResource Glyph}"/></Button>
        <Button x:Name="RedoButton" Click="RedoClick" IsEnabled="False" ToolTip="Redo · Ctrl+Y / Ctrl+Shift+Z" AutomationProperties.Name="Redo"><TextBlock Text="&#xE7A6;" Style="{StaticResource Glyph}"/></Button>
        <Button x:Name="InfoButton" Click="InfoClick" IsEnabled="False" ToolTip="Image information · Ctrl+I" AutomationProperties.Name="Image information"><TextBlock Text="&#xE946;" Style="{StaticResource Glyph}"/></Button>
        <Button x:Name="SaveButton" Content="Save copy" Click="SaveCopyClick" IsEnabled="False" Background="#E8EEE6" Margin="8,0,4,0"/>
        <Button Click="MoreClick" ToolTip="More options" AutomationProperties.Name="More options"><TextBlock Text="&#xE712;" Style="{StaticResource Glyph}"/></Button>
      </StackPanel>
    </Grid>
    <Border x:Name="MarkupBar" Grid.Row="2" Visibility="Collapsed" BorderBrush="#E5E8E0" BorderThickness="0,1,0,1" Background="#F4F6F1" Padding="22,8">
      <StackPanel><DockPanel>
        <Button DockPanel.Dock="Right" Content="Done" Click="DoneClick" Background="#E1E9DD" Margin="12,0,0,0"/>
        <Button x:Name="ApplyCropButton" DockPanel.Dock="Right" Content="Apply crop" Click="ApplyCropClick" Visibility="Collapsed" Background="#E1E9DD"/>
        <WrapPanel Orientation="Horizontal" x:Name="DrawingTools">
          <Button Tag="Select" Content="&#xE8B0;" FontFamily="Segoe Fluent Icons" Click="ToolClick" ToolTip="Select and move objects · V" AutomationProperties.Name="Select objects"/>
          <Button Tag="Pen" Content="&#xED63;" FontFamily="Segoe Fluent Icons" Click="ToolClick" ToolTip="Freehand pen" AutomationProperties.Name="Pen"/>
          <Button Tag="Rectangle" Content="&#xE739;" FontFamily="Segoe Fluent Icons" Click="ToolClick" ToolTip="Rectangle" AutomationProperties.Name="Rectangle"/>
          <Button Tag="Ellipse" Content="&#xEA3A;" FontFamily="Segoe Fluent Icons" Click="ToolClick" ToolTip="Ellipse" AutomationProperties.Name="Ellipse"/>
          <Button Tag="Arrow" Content="↗" FontSize="20" Padding="12,2" Click="ToolClick" ToolTip="Arrow" AutomationProperties.Name="Arrow"/>
          <Button Tag="Text" Content="T" FontWeight="SemiBold" Click="ToolClick" ToolTip="Add text · T" AutomationProperties.Name="Add text"/>
          <Border Width="1" Background="#DDE3D6" Margin="14,4"/>
          <RadioButton Tag="#FFFFFF" Background="White" Style="{StaticResource InkSwatch}" GroupName="Ink" IsChecked="True" Click="ColorClick" ToolTip="White" AutomationProperties.Name="White ink"/>
          <RadioButton Tag="#27362C" Background="#27362C" Style="{StaticResource InkSwatch}" GroupName="Ink" Click="ColorClick" ToolTip="Charcoal" AutomationProperties.Name="Charcoal ink"/>
          <RadioButton Tag="#F5CE64" Background="#F5CE64" Style="{StaticResource InkSwatch}" GroupName="Ink" Click="ColorClick" ToolTip="Yellow" AutomationProperties.Name="Yellow ink"/>
          <RadioButton Tag="#EF7869" Background="#EF7869" Style="{StaticResource InkSwatch}" GroupName="Ink" Click="ColorClick" ToolTip="Coral" AutomationProperties.Name="Coral ink"/>
          <RadioButton Tag="#79A9DB" Background="#79A9DB" Style="{StaticResource InkSwatch}" GroupName="Ink" Click="ColorClick" ToolTip="Blue" AutomationProperties.Name="Blue ink"/>
          <TextBlock x:Name="StrokeLabel" Text="Stroke" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="18,0,7,0"/>
          <ComboBox x:Name="StrokeSize" Width="64" SelectedIndex="1" SelectionChanged="StrokeChanged" ToolTip="Stroke width in image pixels"><ComboBoxItem Content="2"/><ComboBoxItem Content="5"/><ComboBoxItem Content="10"/><ComboBoxItem Content="20"/></ComboBox>
          <TextBlock x:Name="FontLabel" Text="Font" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="18,0,7,0" Visibility="Collapsed"/>
          <TextBox x:Name="FontSizeInput" Text="48" Width="58" Height="32" Padding="7,4" Visibility="Collapsed" LostKeyboardFocus="FontSizeChanged" KeyDown="FontSizeKeyDown" ToolTip="Text size in image pixels · Enter to apply" AutomationProperties.Name="Text font size"/>
          <Button x:Name="DeleteAnnotationButton" Content="&#xE74D;" FontFamily="Segoe Fluent Icons" Click="DeleteAnnotationClick" ToolTip="Delete selected object · Delete" AutomationProperties.Name="Delete selected object" Margin="8,0,0,0" IsEnabled="False"/>
        </WrapPanel>
        <TextBlock x:Name="CropHint" Text="Drag to select an area. Enter to crop · Esc to cancel" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Visibility="Collapsed"/>
      </DockPanel><TextBlock x:Name="AnnotationHint" Text="Select an object to move or resize it." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/></StackPanel>
    </Border>
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border x:Name="CanvasArea" Background="#F0F2ED" BorderBrush="#E3E7DE" BorderThickness="0,1,0,1" ClipToBounds="True">
        <Grid>
          <ScrollViewer x:Name="Viewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="30" SizeChanged="ViewerSizeChanged" PreviewMouseWheel="ViewerMouseWheel" ScrollChanged="ViewerScrolled">
            <Grid x:Name="ImageHost" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White">
              <Grid.LayoutTransform><ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/></Grid.LayoutTransform>
              <Image x:Name="Photo" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
              <local:AnnotationEditor x:Name="Annotations" ClipToBounds="True"/>
              <Canvas x:Name="Overlay" Visibility="Collapsed" Background="Transparent" ClipToBounds="True" MouseLeftButtonDown="CanvasDown" MouseMove="CanvasMove" MouseLeftButtonUp="CanvasUp" LostMouseCapture="CanvasLostCapture"/>
            </Grid>
          </ScrollViewer>
          <StackPanel x:Name="Welcome" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-12,0,0">
            <Grid Width="180" Height="130" Margin="0,0,0,22">
              <Border Width="106" Height="90" Background="#DEE5D9" CornerRadius="12" RenderTransformOrigin="0.5,0.5" Margin="0,0,28,7"><Border.RenderTransform><RotateTransform Angle="-13"/></Border.RenderTransform></Border>
              <Border Width="110" Height="94" Background="#FCFDF9" BorderBrush="#D1DBCB" BorderThickness="1" CornerRadius="12" Margin="25,10,0,0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><RotateTransform Angle="8"/></Border.RenderTransform>
                <Grid Margin="9"><Border Background="#E5EDDF" CornerRadius="6"/><Ellipse Fill="#D0B87D" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,14,0"/><Path Data="M 0,57 L 29,24 L 49,46 L 63,34 L 90,65 L 0,65 Z" Fill="#8DA68A" VerticalAlignment="Bottom" Margin="0,0,0,0"/></Grid>
              </Border>
            </Grid>
            <TextBlock Text="A little more picture.&#x0a;A little less everything else." TextAlignment="Center" FontSize="29" FontWeight="SemiBold" LineHeight="39"/>
            <TextBlock Text="Open an image. Make it yours. Carry on." Foreground="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" Margin="0,16,0,26"/>
            <Button Content="Open an image" Style="{StaticResource Primary}" HorizontalAlignment="Center" Click="OpenClick"/>
            <TextBlock Text="or drop it here  ·  Ctrl + O" Foreground="#8A9286" HorizontalAlignment="Center" Margin="0,15,0,0"/>
          </StackPanel>
          <Border x:Name="ToastBox" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20,20,20,22" Background="#293B30" CornerRadius="9" Padding="18,11" Visibility="Collapsed" IsHitTestVisible="False"><TextBlock x:Name="ToastText" Foreground="White" TextWrapping="Wrap" MaxWidth="620"/></Border>
        </Grid>
      </Border>
      <Border Grid.Column="1" x:Name="InfoPanel" Width="290" Background="#FAFBF9" BorderBrush="#E1E5DC" BorderThickness="1,1,0,1" Visibility="Collapsed">
        <DockPanel Margin="22,22,18,18">
          <Grid DockPanel.Dock="Top" Margin="0,0,0,22"><TextBlock Text="Image details" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="×" HorizontalAlignment="Right" Click="InfoClick" Padding="8,2" ToolTip="Close details"/></Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="InfoContents"/></ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
    <Grid Grid.Row="4" Margin="22,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="5" Height="5" Fill="#78976E" Margin="0,0,8,0"/><TextBlock x:Name="FileStatus" Text="Just you and your images" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
      <StackPanel x:Name="ZoomTools" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="False">
        <Button Click="ZoomOutClick" Content="−" Padding="10,3" ToolTip="Zoom out · −"/>
        <Button x:Name="ZoomLabel" Click="ActualClick" Content="100%" Padding="8,3" MinWidth="56" ToolTip="Actual size · Ctrl+1"/>
        <Button Click="ZoomInClick" Content="+" Padding="10,3" ToolTip="Zoom in · +"/>
        <Border Width="1" Height="15" Background="#DCE1D6" Margin="10,0"/>
        <Button Content="Fit" Click="FitClick" Padding="8,3" ToolTip="Fit to window · Ctrl+0"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock x:Name="PositionLabel" Text="LOCAL. SIMPLE. YOURS." Foreground="#8B9485" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <Button x:Name="PrevButton" Content="‹" Click="PrevClick" FontSize="20" Padding="10,0" Visibility="Collapsed" ToolTip="Previous image · ←"/>
        <Button x:Name="NextButton" Content="›" Click="NextClick" FontSize="20" Padding="10,0" Visibility="Collapsed" ToolTip="Next image · →"/>
      </StackPanel>
    </Grid>
  </Grid>
  </Border>
</Window>
